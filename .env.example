# ---------------------------------------------------------------------------
# AgentFleet configuration. Copy to .env and fill in.
#
# Generate the two secrets first — the orchestrator refuses to start in
# production without them:
#   openssl rand -base64 32        -> JWT_SECRET
#   openssl rand -base64 32        -> MASTER_KEY
# Rotating MASTER_KEY makes every stored credential unreadable. Back it up
# somewhere that is not this repository.
# ---------------------------------------------------------------------------

AGENTFLEET_ENV=development
API_PORT=8080
ADMIN_PORT=8081
LOG_LEVEL=info

# The address this orchestrator is reachable at from outside. It is what the
# OAuth redirect URI is built from, so a provider sign-in started on your phone
# will fail if this says localhost — the phone would be redirected to itself.
# Set it to the host and port the app actually connects to.
PUBLIC_URL=http://localhost:8080

JWT_SECRET=
MASTER_KEY=

POSTGRES_USER=agentfleet
POSTGRES_PASSWORD=agentfleet
POSTGRES_DB=agentfleet

# Group id that owns /var/run/docker.sock on the host. `make up` fills this in;
# check with: stat -c %g /var/run/docker.sock
DOCKER_GID=999

# --- fleet ------------------------------------------------------------------
SANDBOX_IMAGE=agentfleet/sandbox:latest
# Hard ceiling on concurrent sandboxes. Size it against host RAM, not optimism:
# four power-user instances is 32 GB before the host itself is counted.
MAX_INSTANCES=8
# Global kill switch for the shell action. Instances still have to opt in.
ALLOW_SHELL=true
# Publish each sandbox on loopback as well as through the proxy. Off by default;
# only useful when debugging a sandbox directly.
PUBLISH_PORTS=false
SCREEN_RESOLUTION=1920x1080x24

# --- agent loop -------------------------------------------------------------
AGENT_MAX_STEPS=60
AGENT_STEP_TIMEOUT_SEC=120
# Identical screens in a row before the agent stops and asks for help.
AGENT_STALL_THRESHOLD=3
# Screenshot width sent to the model. The single biggest lever on token cost;
# below ~1024 small UI text stops being readable.
AGENT_SCREENSHOT_MAX_WIDTH=1280

# Coordinate convention the vision model answers in.
#   auto       - show the model a calibration frame on first use and measure it
#   pixel      - coordinates are already in the screenshot's resolution
#   normalized - model reports 0-1000 on both axes and we rescale
# Qwen2.5-VL is pixel; Qwen3/Qwen3.5 are normalized and ignore any prompt to
# the contrary. auto covers both, and any model not on that list. If the frame
# cannot be classified the run falls back to pixel and says so in the log.
AGENT_COORD_SPACE=auto

# --- models -----------------------------------------------------------------
# Seeded on first boot so a fresh install has something to run against.
#
# qwen3.5:4b is small enough to answer promptly on a single consumer GPU, which
# is what most of this runs on. It reports coordinates on a 0-1000 scale rather
# than in pixels; AGENT_COORD_SPACE=auto above already handles that, so leave
# it alone unless you pin a model.
#
# Pull it before first boot:  ollama pull qwen3.5:4b
# Larger alternatives, same settings: qwen2.5vl:7b, qwen2.5vl:72b.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen3.5:4b
# Cloud keys are entered in the admin panel and sealed into the vault — do not
# put them here.

# Embedding model for episodic memory search, when a provider that can embed is
# configured (Ollama, OpenAI, Gemini). Empty picks a sensible per-provider
# default (nomic-embed-text, text-embedding-3-small, text-embedding-004). With
# no embedding-capable provider at all, memory falls back to a keyword index —
# /api/memory/fleet reports which one is in use.
EMBED_MODEL=

# Refuse stdio MCP servers entirely. Registering one asks the orchestrator to
# execute a command in its own container; admin-only and logged, but worth
# turning off wherever more than one person holds admin.
MCP_DISABLE_STDIO=false

# Live model pricing. The cost dashboard prices turns from OpenRouter's public
# catalogue, refreshed daily, and falls back to the built-in list-price table
# offline; the financial summary reports which source is in effect. Set to
# "off" for air-gapped fleets.
PRICING_REFRESH=on

# Text-to-speech sidecar. The default reaches the `tts` compose service; point
# it elsewhere if the sidecar runs on another host, or leave the service
# undeployed and both the API and the agents report speech as unavailable.
TTS_BASE_URL=http://tts:8080

# --- artifacts --------------------------------------------------------------
# fs (a docker volume) or s3 (MinIO/AWS). Start with fs.
ARTIFACT_BACKEND=fs
S3_BUCKET=agentfleet
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- first admin ------------------------------------------------------------
# Optional: seeds an admin on first boot. Leave blank to create one through the
# login screen instead.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- push notifications -----------------------------------------------------
# Path on the HOST to the Firebase service account JSON; it is mounted read-only
# into the api container at /etc/agentfleet/fcm.json.
FCM_SERVICE_ACCOUNT_HOST=./deploy/placeholder
FCM_SERVICE_ACCOUNT=/etc/agentfleet/fcm.json
FCM_PROJECT_ID=

# Direct APNs, for iOS builds that skip Firebase.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_TOPIC=

# How long to wait for a model reply before giving up. A local model serving
# several agents queues requests, so this is generous by default.
PROVIDER_TIMEOUT_SEC=360
